{
  "version": 1,
  "defaultMode": "dry-run",
  "automaticConfidence": "HIGH",
  "relatedRecommendationLimit": 8,
  "allowlist": [
    "SEARCH_INDEX_REGENERATE",
    "RELATED_INDEX_REGENERATE",
    "HUB_INDEX_REGENERATE",
    "SITEMAP_REGENERATE"
  ],
  "protectedFields": [
    "title",
    "description",
    "h1",
    "body",
    "faq",
    "cta",
    "keyword",
    "province",
    "region",
    "subject",
    "target",
    "slug",
    "url",
    "canonical"
  ],
  "backup": {
    "directory": ".backups/seo-fix",
    "files": [
      "public/search-index.json",
      "public/related-index.json",
      "public/hub-index.json",
      "dist/search-index.json",
      "dist/related-index.json",
      "dist/hub-index.json",
      "dist/sitemap.xml",
      ".cache/build-manifest.json"
    ]
  },
