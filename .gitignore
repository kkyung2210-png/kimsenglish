# 생성 중 잠깐 사용하는 폴더는 GitHub에 올리지 않습니다.
.dist-building/
.cache/
build-report.json
build-errors.json
reports/
.audit-test-fixture/
.seo-fix-test-fixture/
.brand-assets-test-dist/
.backups/

# dist는 Netlify가 배포할 때 다시 만들 수 있습니다.
dist/

# Node.js가 내려받는 큰 외부 파일은 올리지 않습니다.
node_modules/
.search-console-test-fixture/

# Netlify가 내 컴퓨터에서 만드는 설정과 임시 결과입니다.
.netlify/

# 실행 로그와 임시 파일은 프로젝트 원본이 아닙니다.
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# 비밀번호나 환경 설정이 들어갈 수 있는 파일은 공개하지 않습니다.
.env
.env.*
!.env.example

# Windows와 macOS가 자동 생성하는 파일은 제외합니다.
Thumbs.db
Desktop.ini
.DS_Store

# VSCode의 개인별 화면 설정은 제외합니다.
.vscode/
